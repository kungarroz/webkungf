{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "site",
  "redirects": [
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/es/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/en/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/zh-cn/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/zh/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/obra", "destination": "/", "permanent": true },
    { "source": "/sobre-mi", "destination": "/", "permanent": true },
    { "source": "/contacto", "destination": "/", "permanent": true },
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/sitemap-0.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/logo.svg", "destination": "/favicon.svg", "permanent": true },
    { "source": "/ogp.png", "destination": "/og.jpg", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" }
      ]
    },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(css|js|i18n)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}

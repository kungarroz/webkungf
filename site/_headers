# Cloudflare Pages · cabeceras
# Si activas Cloudflare Web Analytics, amplía la CSP de la primera regla así:
#   script-src 'self' https://static.cloudflareinsights.com
#   connect-src 'self' https://cloudflareinsights.com
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/fonts/source-serif-4-latin.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/source-serif-4-italic-latin.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/dm-mono-latin.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/noto-serif-sc-zh.woff2
  Cache-Control: public, max-age=3600

/img/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/i18n/*
  Cache-Control: public, max-age=3600

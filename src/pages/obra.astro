    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <title>Obra | Kungfundidos</title>
  </head>
  <body style="margin: 0; background-color: #050505;">
    <ObraPage client:load />
  </body>
</html>


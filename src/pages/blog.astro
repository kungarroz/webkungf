---
import BlogPage from '../components/BlogPage.jsx';
import { getCollection } from 'astro:content';

// 1. Carga MASIVA de todas las imágenes en la carpeta content
const allImages = import.meta.glob('/src/content/blog/**/*.{jpg,jpeg,png,webp}', { eager: true });

// 2. Obtener posts
const allPosts = await getCollection('blog');

// DETECTAR IDIOMA (Default a 'es')
const currentLang = Astro.currentLocale || 'es';

// Filtramos los posts que no coincidan con el idioma actual
const postsInLanguage = allPosts.filter(post => {
  return post.slug.startsWith(`${currentLang}/`);
});

const mappedPosts = postsInLanguage.map((post) => {
  const cleanId = post.id.replace(/\\/g, '/');
  const folderPath = cleanId.substring(0, cleanId.lastIndexOf('/'));
  const basePath = `/src/content/blog/${folderPath}`;
  
  let finalImage = null;

  // --------------------------------------------------------------------------
  // LÓGICA DE IMAGEN MEJORADA
  // --------------------------------------------------------------------------

  // 1. Intentamos buscar archivos estándar (Cover.jpg, cover.jpg, etc.)
  const standardNames = [
    'Cover.jpg', 'cover.jpg', 'Cover.jpeg', 'cover.jpeg',
    'Cover.png', 'cover.png', 'Cover.webp', 'cover.webp',
    `${post.slug.split('/').pop()}.jpg` // Nombre igual al slug
  ];

  for (const name of standardNames) {
    const fullPath = `${basePath}/${name}`;
    if (allImages[fullPath]) {
      // @ts-ignore
      finalImage = allImages[fullPath].default.src;
      break; // Encontrada, dejamos de buscar
    }
  }

  // 2. Si no encontramos una estándar, miramos qué dice el Frontmatter
  if (!finalImage) {
    // @ts-ignore
    const metaCover = post.data.heroImage || post.data.cover;

    if (metaCover) {
      if (typeof metaCover === 'string') {
        // CASO CLAVE: El usuario puso 'cover: "./DSC00907.JPG"'
        // Limpiamos el './' del principio para tener solo el nombre del archivo
        const cleanName = metaCover.replace(/^\.\//, '');
        
        // Construimos la ruta completa esperada
        const specificPath = `${basePath}/${cleanName}`;
        
        // Buscamos si esa imagen específica existe en nuestra carga masiva
        if (allImages[specificPath]) {
             // @ts-ignore
             finalImage = allImages[specificPath].default.src;
        } else {
             // Si no está en los archivos locales, asumimos que es una URL externa (https://...)
             finalImage = metaCover;
        }
      } else if (typeof metaCover === 'object' && metaCover.src) {
        // Caso: Astro ya procesó la imagen en el frontmatter (menos común en MDX puro sin config estricta)
        finalImage = metaCover.src;
      }
    }
  }
  // --------------------------------------------------------------------------


  // Gestión de Fecha
  let formattedDate = 'Fecha pendiente';
  try {
    // @ts-ignore
    const d = post.data.pubDate || post.data.date || new Date();
    formattedDate = new Date(d).toLocaleDateString('es-ES', { 
      day: '2-digit', month: 'short', year: 'numeric' 
    }).toUpperCase();
  } catch (e) {}

  // @ts-ignore
  const tags = post.data.tags || [];

  // Categoría
  let category = 'Blog';
  const t = post.data.title.toLowerCase();
  if (t.includes('review') || post.slug.includes('ttartisan')) category = 'Reviews';
  else if (t.includes('guía') || t.includes('tutorial')) category = 'Técnica';
  else category = 'Reflexiones';

  // Generar enlace limpio: /es/blog/nombre-post
  const link = `/${currentLang}/blog/${post.slug.split('/').slice(1).join('/')}`;

  return {
    slug: post.slug,
    title: post.data.title,
    excerpt: post.data.description,
    date: formattedDate,
    folderPath: folderPath,
    category: category,
    tags: tags, 
    content: "", 
    image: finalImage || "https://placehold.co/600x400/222/999?text=Sin+Imagen", 
    link: link
  };
});

// --- LÓGICA SEO MULTILINGÜE ---
const siteUrl = import.meta.env.SITE || 'https://kungfundidos.com';

const esBlogUrl = `${siteUrl}/es/blog`;
const enBlogUrl = `${siteUrl}/en/blog`;
const cnBlogUrl = `${siteUrl}/cn/blog`;

const htmlLang = currentLang === 'cn' ? 'zh-Hans' : currentLang;
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    
    <link rel="icon" type="image/svg+xml" href="/logo.svg?v=final" />
    
    <title>Kungfundidos Journal</title>

    <link rel="alternate" hreflang="es" href={esBlogUrl} />
    <link rel="alternate" hreflang="en" href={enBlogUrl} />
    <link rel="alternate" hreflang="zh-Hans" href={cnBlogUrl} />
  </head>
  <body class="bg-gray-50 min-h-screen">
    {/* @ts-ignore */}
    <BlogPage client:only="react" automaticPosts={mappedPosts} />
  </body>
</html>
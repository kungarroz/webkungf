---
// src/pages/links.astro
import Layout from "@/layouts/Base.astro";
---

<Layout>
  <main class="links-screen">
    <nav class="links">
      <a
        class="link-btn substack"
        href="https://substack.com/@kungfundidos"
        target="_blank"
        rel="noopener noreferrer"
      >
        Substack
      </a>

      <a
        class="link-btn youtube"
        href="https://www.youtube.com/@Kungfundidos"
        target="_blank"
        rel="noopener noreferrer"
      >
        YouTube
      </a>

      <a
        class="link-btn instagram"
        href="https://www.instagram.com/kungfundidos"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>

      <a
        class="link-btn xhs"
        href="https://www.xiaohongshu.com/user/profile/62433dff0000000010005059"
        target="_blank"
        rel="noopener noreferrer"
      >
        小红书 Xiaohongshu
      </a>
    </nav>
  </main>
</Layout>

<style>
  :root { color-scheme: light dark; }

  .links-screen {
    /* Fallback + dinámico para evitar “salto” por barras del navegador */
    min-height: 100vh;
    min-height: 100dvh;
    padding:
      max(12px, env(safe-area-inset-top))
      max(16px, env(safe-area-inset-right))
      max(12px, env(safe-area-inset-bottom))
      max(16px, env(safe-area-inset-left));
    display: grid;
    place-items: center;
  }

  .links {
    width: 100%;
    max-width: 480px;
    height: 100%;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: 12px;
  }

  .link-btn {
    display: grid;
    place-items: center;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: clamp(16px, 4.5vw, 20px);
    line-height: 1;
    /* Objetivo táctil cómodo (≥44px) */
    min-height: 56px;
    color: #fff;
  }

  /* Colores por plataforma (simples y reconocibles) */
  .substack { background: #FF6719; }
  .youtube  { background: #FF0033; }
  .instagram{
    background: linear-gradient(45deg,#f58529,#dd2a7b,#8134af,#515bd4);
  }
  .xhs      { background: #FF2442; }

  @media (min-width: 768px) {
    .links { max-width: 420px; }
  }
</style>

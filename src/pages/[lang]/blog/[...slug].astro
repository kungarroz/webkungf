---
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  return posts.map(post => {
    const parts = post.slug.split('/');
    const lang = parts.length > 1 ? parts[0] : 'es';
    const cleanSlug = parts.length > 1 ? parts.slice(1).join('/') : post.slug;

    return {
      params: { lang: lang, slug: cleanSlug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

// --- LÓGICA SEO MULTILINGÜE ---
// 1. Tu dominio base (Asegúrate que coincida con tu astro.config o cámbialo aquí a mano)
const siteUrl = import.meta.env.SITE || 'https://kungfundidos.com';

// 2. Limpiamos el slug para quitarle el idioma (es/post -> post)
const baseSlug = post.slug.split('/').slice(1).join('/');

// 3. Generamos las URLs absolutas para las etiquetas hreflang
const esUrl = `${siteUrl}/es/blog/${baseSlug}`;
const enUrl = `${siteUrl}/en/blog/${baseSlug}`;
const cnUrl = `${siteUrl}/cn/blog/${baseSlug}`;

// 4. Corregimos el código de idioma para el HTML (cn -> zh-Hans para estándares web)
const currentLang = Astro.params.lang;
const htmlLang = currentLang === 'cn' ? 'zh-Hans' : currentLang;
// ------------------------------

// @ts-ignore
const heroImage = post.data.heroImage || post.data.cover?.src || post.data.cover;

// @ts-ignore
const postDate = post.data.pubDate || post.data.date;

const category = "Blog"; 
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <title>{post.data.title}</title>
    <meta name="viewport" content="width=device-width" />
    
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-Hans" href={cnUrl} />
  </head>
  <body class="bg-[#050505] text-[#e5e5e5] font-serif antialiased">
    
    <article class="max-w-3xl mx-auto px-6 py-20 markdown-content">
      
      {/* Botón volver */}
      <a href="/blog" class="inline-block mb-12 text-xs uppercase tracking-widest text-neutral-500 hover:text-red-600 transition-colors">
        ← Volver al Blog
      </a>

      {/* Cabecera */}
      <header class="mb-16 text-center border-b border-neutral-800 pb-12">
        <div class="text-xs font-sans uppercase tracking-widest text-red-600 mb-4">
          {category}
        </div>
        <h1 class="text-4xl md:text-6xl font-light italic mb-6 text-white leading-tight">
          {post.data.title}
        </h1>
        <div class="text-neutral-500 font-sans text-xs uppercase tracking-widest">
           {new Date(postDate).toLocaleDateString(Astro.params.lang, { dateStyle: 'long' })}
        </div>
      </header>

      {/* Imagen Principal */}
      {heroImage && (
        <div class="mb-16 aspect-video overflow-hidden bg-neutral-900 rounded-sm">
          <img 
            src={heroImage} 
            alt={post.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      {/* CONTENIDO DEL POST */}
      <div class="content-wrapper font-sans text-lg leading-relaxed text-neutral-300">
        <Content />
      </div>

    </article>

    {/* ESTILOS MANUALES */}
    <style is:global>
      .markdown-content h2 {
        display: block;
        font-size: 2rem !important;
        font-weight: 700;
        color: #ffffff;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      .markdown-content h3 {
        display: block;
        font-size: 1.5rem !important;
        font-weight: 600;
        color: #e5e5e5;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
      }

      .markdown-content p {
        margin-bottom: 1.5em;
        line-height: 1.8;
      }

      .markdown-content strong {
        color: #fff;
        font-weight: 700;
      }

      .markdown-content img {
        width: 100%;
        height: auto;
        border-radius: 4px;
        margin: 2.5rem 0;
        border: 1px solid #222;
      }

      .markdown-content ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
      }
      
      .markdown-content li {
        margin-bottom: 0.5rem;
      }
    </style>

  </body>
</html>
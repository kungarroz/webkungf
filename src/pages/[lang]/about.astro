---
import Layout from "@/layouts/Article.astro";
import PolaroidFrame from "@/components/PolaroidFrame.astro";
import { useTranslations } from "@/i18n";

export function getStaticPaths() {
  return [
    {params: {lang: 'en'}},
    {params: {lang: 'es'}},
    {params: {lang: 'zh-cn'}},
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

---

<Layout title={t('about.title')} description={t('about.description')}>
  <div class="about-container">
    <PolaroidFrame
      src="/src/assets/fotos/yo.jpeg"
      alt={t('about.photoAlt')}
      caption={t('about.photoCaption')}
    />

    <div class="about-text">
      <h1>{t('Sobre mí')}</h1>

      <p>{t('Me apasiona la fotografía callejera y mi segundo hogar es Guangzhou, en el sur de China. Con mi cámara, recorro sus calles buscando esos pequeños momentos que hacen única la vida diaria: una sonrisa entre desconocidos, la luz del atardecer colándose entre los edificios o el vapor que sale de un puesto de fideos.')}</p>
      <p>{t('No soy ningún experto - solo alguien que disfruta capturando la vida tal como es, sin pretensiones. Mi equipo es sencillo y mi técnica también, pero lo que me mueve es compartir estas pequeñas historias visuales que encuentro en cada esquina.')}</p>
      <p>{t('Si te interesa ver Guangzhou a través de los ojos de un vecino más, te invito a explorar estas fotos conmigo. ¡Siempre es un placer conocer a otros apasionados de la fotografía o simplemente charlar sobre estas calles que tanto me han enseñado!')}</p>
    </div>
  </div>
</Layout>

<style>
  .about-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .about-text {
    text-align: justify;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .about-container {
      flex-direction: row;
      align-items: flex-start;
    }

    .about-text {
      flex: 1;
    }
  }
</style>

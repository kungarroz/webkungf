---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
const t = useTranslations(Astro.currentLocale as Lang);
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale as Lang;

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

import AstroImageAbout from "@/assets/fotos/about.jpeg";
import AstroImageBlog from "@/assets/fotos/blog.jpeg";
import AstroImagePort from "@/assets/fotos/portfolio.jpeg";

---

<Layout>
  <div class="photo-grid">
    <!-- Foto 1 -->
    <div class="photo-wrapper">
      <img src={AstroImageAbout} alt="About" />
      <div class="overlay">
        <p>{t({ es: "Sobre mí", en: "About", "zh-cn": "关于我" })}</p>
      </div>
    </div>
    <!-- Foto 2 -->
    <div class="photo-wrapper">
      <img src={AstroImagePort} alt="Portfolio" />
      <div class="overlay">
        <p>{t({ es: "Portafolio", en: "Portfolio", "zh-cn": "作品集" })}</p>
      </div>
    </div>
    <!-- Foto 3 -->
    <div class="photo-wrapper">
      <img src={AstroImageBlog} alt="Blog" />
      <div class="overlay">
        <p>{t({ es: "Blog", en: "Blog", "zh-cn": "博客" })}</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .photo-wrapper {
    position: relative;
    overflow: hidden;
  }

  .photo-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .photo-wrapper:hover img {
    transform: scale(1.1);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .photo-wrapper:hover .overlay {
    opacity: 1;
  }

  .overlay p {
    color: #fff;
    font-size: 1.5rem;
    font-weight: bold;
    text-align: center;
    margin: 0;
  }
</style>
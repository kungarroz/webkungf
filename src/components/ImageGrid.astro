---
const guangzhouImages = await Astro.glob('/src/assets/fotos/Guangzhou/*.{jpg,jpeg,png,gif}');
const hongKongImages = await Astro.glob('/src/assets/fotos/HongKong/*.{jpg,jpeg,png,gif}');
const macaoImages = await Astro.glob('/src/assets/fotos/Macao/*.{jpg,jpeg,png,gif}');
const retratoImages = await Astro.glob('/src/assets/fotos/Retrato/*.{jpg,jpeg,png,gif}');
---

<div class="masonry-grid">
  <h2>Guangzhou</h2>
  {guangzhouImages.map((image, index) => (
    <div class="masonry-item" key={index}>
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1} de Guangzhou`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}

  <h2>Hong Kong</h2>
  {hongKongImages.map((image, index) => (
    <div class="masonry-item" key={index}>
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1} de Hong Kong`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}

  <h2>Macao</h2>
  {macaoImages.map((image, index) => (
    <div class="masonry-item" key={index}>
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1} de Macao`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}

  <h2>Retrato</h2>
  {retratoImages.map((image, index) => (
    <div class="masonry-item" key={index}>
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1} de Retrato`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<style>
  .masonry-grid {
    column-count: 1;
    column-gap: 1rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.05);
  }

  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 768px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 4;
    }
  }
</style>

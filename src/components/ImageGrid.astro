---
import { Image } from 'astro:assets';

const streetPhotos = await Astro.glob('/src/assets/fotos/**/*.{jpg,jpeg,png,gif}');
const portraitPhotos = await Astro.glob('/src/assets/retratos/**/*.{jpg,jpeg,png,gif}');
---

<div class="filter-buttons">
  <button class="filter-btn active" data-category="all">Todas</button>
  <button class="filter-btn" data-category="street">Fotografía callejera</button>
  <button class="filter-btn" data-category="portrait">Retratos</button>
</div>

<div class="masonry-grid">
  {streetPhotos.map((image, index) => (
    <div class="masonry-item" data-category="street">
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
  {portraitPhotos.map((image, index) => (
    <div class="masonry-item" data-category="portrait">
      <img
        src={image.default.src}
        alt={`Retrato ${index + 1}`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<script>
  // ... (el script de filtrado permanece igual)
</script>

<style>
  /* ... (estilos anteriores permanecen iguales) */

  .masonry-grid {
    column-count: 4;
    column-gap: 1rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    overflow: hidden; /* Añadido para contener la imagen al hacer zoom */
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease; /* Añadido para suavizar el efecto de zoom */
  }

  .masonry-item:hover img {
    transform: scale(1.05); /* Efecto de zoom al hacer hover */
  }

  /* ... (media queries permanecen iguales) */
</style>

---
import { Image } from 'astro:assets';

const images = await Astro.glob('/src/assets/fotos/*/*.{jpg,jpeg,png,gif}');

const categories = ['Todo', 'Retrato', 'Guangzhou', 'Hong Kong', 'Macao'];

let selectedCategory = 'Todo';

// Organizar las imágenes por categoría
const categorizedImages: Record<string, typeof images> = {
  'Retrato': [],
  'Guangzhou': [],
  'Hong Kong': [],
  'Macao': []
};

// Asignar imágenes a sus categorías
for (const image of images) {
  const category = image.default.src.split('/').slice(-2, -1)[0]; // Obtener la categoría del path
  if (categorizedImages[category]) {
    categorizedImages[category].push(image);
  }
}

// Filtrar imágenes según la categoría seleccionada
const filteredImages = selectedCategory === 'Todo' 
  ? images 
  : categorizedImages[selectedCategory];
---

<div>
  <h2>Galería de Imágenes</h2>

  <div class="category-buttons">
    {categories.map(category => (
      <button onclick={() => selectedCategory = category}>{category}</button>
    ))}
  </div>

  <div class="masonry-grid">
    {filteredImages.map((image, index) => (
      <div class="masonry-item" key={index}>
        <img
          src={image.default.src}
          alt={`Fotografía ${index + 1}`}
          width={400}
          height={image.default.height * (400 / image.default.width)}
          class="gallery-image"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .masonry-grid {
    column-count: 1;
    column-gap: 1rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.05);
  }

  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 768px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 4;
    }
  }
</style>

---
import { Image } from 'astro:assets';

const guangzhouImages = await Astro.glob('/src/assets/fotos/portfolio/Guangzhou/*.{jpg,jpeg,png,gif}');
const hongKongImages = await Astro.glob('/src/assets/fotos/portfolio/HongKong/*.{jpg,jpeg,png,gif}');
const macaoImages = await Astro.glob('/src/assets/fotos/portfolio/Macao/*.{jpg,jpeg,png,gif}');
const retratoImages = await Astro.glob('/src/assets/fotos/portfolio/Retrato/*.{jpg,jpeg,png,gif}');
---

<div class="masonry-grid">
  {guangzhouImages.map((guangzhouImages, index) => (
    <div class="masonry-item">
      <img
        src={guangzhouImages.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={guangzhouImages.default.height * (400 / guangzhouImages.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<div class="masonry-grid">
  {hongKongImages.map((hongKongImages, index) => (
    <div class="masonry-item">
      <img
        src={hongKongImages.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={hongKongImages.default.height * (400 / hongKongImages.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<div class="masonry-grid">
  {macaoImages.map((macaoImages, index) => (
    <div class="masonry-item">
      <img
        src={macaoImages.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={macaoImages.default.height * (400 / macaoImages.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<div class="masonry-grid">
  {retratoImages.map((retratoImages, index) => (
    <div class="masonry-item">
      <img
        src={retratoImages.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={retratoImages.default.height * (400 / retratoImages.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<style>
  .masonry-grid {
    column-count: 1;
    column-gap: 1rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.05);
  }

  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 768px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 4;
    }
  }
</style>

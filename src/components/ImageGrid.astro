---
import { Image } from 'astro:assets';

const streetPhotos = await Astro.glob('/src/assets/fotos/**/*.{jpg,jpeg,png,gif}');
const portraitPhotos = await Astro.glob('/src/assets/retratos/**/*.{jpg,jpeg,png,gif}');
const allPhotos = [...streetPhotos, ...portraitPhotos].sort(() => Math.random() - 0.5);
---

<div class="filter-buttons">
  <button class="filter-btn active" data-category="all">Todas</button>
  <button class="filter-btn" data-category="street">Fotografía callejera</button>
  <button class="filter-btn" data-category="portrait">Retratos</button>
</div>

<div class="masonry-grid">
  {allPhotos.map((image, index) => (
    <div class="masonry-item" data-category={streetPhotos.includes(image) ? "street" : "portrait"}>
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<script>
  import Masonry from 'masonry-layout';

  const filterButtons = document.querySelectorAll('.filter-btn');
  const masonryItems = document.querySelectorAll<HTMLElement>('.masonry-item');
  let msnry: Masonry | null = null;

  function initMasonry() {
    msnry = new Masonry('.masonry-grid', {
      itemSelector: '.masonry-item',
      columnWidth: '.masonry-item',
      percentPosition: true
    });
  }

  function filterItems(category: string) {
    masonryItems.forEach(item => {
      const shouldShow = category === 'all' || item.getAttribute('data-category') === category;
      item.style.display = shouldShow ? 'block' : 'none';
    });
    if (msnry) {
      msnry.layout();
    }
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category') || 'all';
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');
      filterItems(category);
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    initMasonry();
    filterItems('all');
  });
</script>

<style>
  .filter-buttons {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background-color: #f9f9f9;
    border-radius: 10px;
    overflow-x: auto;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border: none;
    background-color: transparent;
    color: #333;
    cursor: pointer;
    transition: color 0.3s ease;
    position: relative;
    white-space: nowrap;
  }

  .filter-btn::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #333;
    transition: width 0.3s ease;
  }

  .filter-btn:hover::after,
  .filter-btn.active::after {
    width: 100%;
  }

  .filter-btn.active {
    font-weight: bold;
  }

  .masonry-grid {
    width: 100%;
  }

  .masonry-item {
    width: calc(25% - 1rem);
    margin-bottom: 1rem;
    transition: opacity 0.3s ease;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 1024px) {
    .masonry-item {
      width: calc(33.333% - 1rem);
    }
  }

  @media (max-width: 768px) {
    .masonry-item {
      width: calc(50% - 1rem);
    }
    
    .filter-btn {
      padding: 0.4rem 0.8rem;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 480px) {
    .masonry-item {
      width: 100%;
    }
  }
</style>

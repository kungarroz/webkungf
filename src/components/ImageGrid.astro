---
// Definir los tipos para las imágenes
const guangzhouImages = await Astro.glob('/src/assets/fotos/portfolio/Guangzhou/*.{jpg,jpeg,png,gif}');
const hongKongImages = await Astro.glob('/src/assets/fotos/portfolio/HongKong/*.{jpg,jpeg,png,gif}');
const macaoImages = await Astro.glob('/src/assets/fotos/portfolio/Macao/*.{jpg,jpeg,png,gif}');
const retratoImages = await Astro.glob('/src/assets/fotos/portfolio/Retrato/*.{jpg,jpeg,png,gif}');

// Ajuste de tipo: transformar en la forma correcta
const transformImages = (images) => {
  return images.map((image) => ({
    default: {
      src: image,
      height: 500,  // Asignar un valor de altura, o bien puedes obtenerlo dinámicamente si se puede
      width: 500    // Asignar un valor de ancho, o bien puedes obtenerlo dinámicamente si se puede
    }
  }));
};

const categorizedImages = [
  { category: 'Guangzhou', images: transformImages(guangzhouImages) },
  { category: 'Hong Kong', images: transformImages(hongKongImages) },
  { category: 'Macao', images: transformImages(macaoImages) },
  { category: 'Retrato', images: transformImages(retratoImages) }
];
---

<div class="masonry-grid">
  {categorizedImages.map(({ category, images }) => (
    <div class="category-section" key={category}>
      <h2>{category}</h2>
      <div class="masonry-item-container">
        {images.map((image, imgIndex) => (
          <div class="masonry-item" key={imgIndex}>
            <img
              src={image.default.src}
              alt={`Fotografía ${imgIndex + 1} de ${category}`}
              width={400}
              height={image.default.height * (400 / image.default.width)}
              class="gallery-image"
            />
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .masonry-grid {
    column-count: 1;
    column-gap: 1rem;
  }

  .category-section {
    margin-bottom: 2rem;
  }

  .masonry-item-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .masonry-item {
    flex-basis: calc(25% - 1rem);
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.05);
  }

  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 768px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 4;
    }
  }
</style>
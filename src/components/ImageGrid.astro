---
import { Image } from "astro:assets";

let selectedCategory = ""; // Definimos una variable inicial para la categoría seleccionada

// Función para filtrar las imágenes según la categoría seleccionada
function filterImages(images) {
  return images.filter((image) => {
    return selectedCategory === "" || image.category === selectedCategory;
  });
}

// Función para renderizar la galería de imágenes
function renderGallery(images) {
  const filteredImages = filterImages(images);
  return filteredImages
    .map(
      (image, index) => `
        <div class="image-card" key=${index}>
          <img src="${image.src}" alt="${image.alt}" />
        </div>
      `
    )
    .join("");
}

// Lista de imágenes de ejemplo
const images = [
  { src: "/path/to/image1.jpg", alt: "Image 1", category: "nature" },
  { src: "/path/to/image2.jpg", alt: "Image 2", category: "architecture" },
  // Agrega más imágenes aquí
];

const categories = ["", "nature", "architecture"]; // Categorías disponibles
---

<div id="gallery">
  <div class="categories">
    {categories.map((category) => (
      <button
        class={`category-button ${
          selectedCategory === category ? "active" : ""
        }`}
        onclick={() => {
          selectedCategory = category;
          document.getElementById("gallery").innerHTML = renderGallery(images);
        }}
      >
        {category || "All"}
      </button>
    ))}
  </div>

  <div id="image-grid" class="image-grid">
    {renderGallery(images)}
  </div>
</div>

<style>
  .categories {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .category-button {
    padding: 0.5rem 1rem;
    cursor: pointer;
    border: 1px solid #ccc;
    background: white;
  }
  .category-button.active {
    background: #0070f3;
    color: white;
  }
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }
  .image-card img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
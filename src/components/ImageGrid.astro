---
import { Image } from 'astro:assets';

// Importa tus imágenes desde assets/fotos
const images = await Astro.glob('/src/assets/fotos/*.{jpg,jpeg,png,gif}');
---

<div class="image-grid">
  {images.map((image) => (
    <div class="image-item">
      <Image
        src={image.default}
        alt="Fotografía"
        width={600}
        height={image.default.height * (600 / image.default.width)}
      />
    </div>
  ))}
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-gap: 1rem;
    grid-auto-rows: auto;
  }

  .image-item {
    overflow: hidden;
    position: relative;
  }

  .image-item img {
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .image-item:hover img {
    transform: scale(1.05);
  }

  @media (min-width: 768px) {
    .image-grid {
      grid-auto-flow: dense;
    }

    .image-item:nth-child(4n+1) {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>

---
// ImageGrid.astro

type ImageType = {
  src: string;
  alt: string;
};

const categories = ["Retrato", "Guangzhou", "Hong Kong", "Macao"];

// Importar todas las imágenes de las carpetas
const images = import.meta.glob('../fotos/*/*.jpeg', { eager: true });

const categorizedImages: Record<string, ImageType[]> = {
  "Retrato": [],
  "Guangzhou": [],
  "Hong Kong": [],
  "Macao": []
};

// Organizar las imágenes por categoría
for (const path in images) {
  const category = path.split('/')[2]; // Obtener la categoría del path
  if (categorizedImages[category]) {
    categorizedImages[category].push({ src: images[path].default, alt: `${category} image` });
  }
}


let selectedCategory: string = "Todo";

const filteredImages = selectedCategory === "Todo" 
  ? Object.values(categorizedImages).flat() 
  : categorizedImages[selectedCategory];
---

<div>
  <h2>Galería de Imágenes</h2>

  <div class="category-buttons">
    <button onclick={() => selectedCategory = "Todo"}>Todo</button>
    {categories.map(category => (
      <button onclick={() => selectedCategory = category}>{category}</button>
    ))}
  </div>

  <div class="photo-grid">
    {filteredImages.map(image => (
      <div class="photo-wrapper">
        <img src={image.src} alt={image.alt} />
      </div>
    ))}
  </div>
</div>

<style>
  .category-buttons {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .photo-wrapper {
    position: relative;
    overflow: hidden;
  }

  .photo-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .photo-wrapper:hover img {
    transform: scale(1.1);
  }
</style>

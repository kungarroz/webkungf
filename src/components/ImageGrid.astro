---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from "@/i18n";

const streetPhotos = await Astro.glob('/src/assets/fotos/**/*.{jpg,jpeg,png,gif}');
const portraitPhotos = await Astro.glob('/src/assets/retratos/**/*.{jpg,jpeg,png,gif}');

const t = useTranslations(Astro.currentLocale as Lang);
---

<div class="filter-buttons">
  <button class="filter-btn active" data-category="all">
    {t({ es: "Todas", en: "All", "zh-cn": "所有" })}
  </button>
  <button class="filter-btn" data-category="street">
    {t({ es: "Fotografía callejera", en: "Street Photography", "zh-cn": "街头摄影" })}
  </button>
  <button class="filter-btn" data-category="portrait">
    {t({ es: "Retratos", en: "Portraits", "zh-cn": "肖像" })}
  </button>
</div>

<div class="masonry-grid">
  {streetPhotos.map((image, index) => (
    <div class="masonry-item" data-category="street">
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
  {portraitPhotos.map((image, index) => (
    <div class="masonry-item" data-category="portrait">
      <img
        src={image.default.src}
        alt={`Retrato ${index + 1}`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
      />
    </div>
  ))}
</div>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const masonryItems = document.querySelectorAll<HTMLElement>('.masonry-item');

  function filterItems(category: string) {
    masonryItems.forEach(item => {
      const shouldShow = category === 'all' || item.dataset.category === category;
      if (shouldShow) {
        item.style.opacity = '0';
        item.style.display = 'block';
        requestAnimationFrame(() => {
          item.style.opacity = '1';
        });
      } else {
        item.style.opacity = '0';
        setTimeout(() => {
          item.style.display = 'none';
        }, 300);
      }
    });
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category') || 'all';
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');
      filterItems(category);
    });
  });

  // Aplicar el filtro inicial
  filterItems('all');
</script>

<style>
  .filter-buttons {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background-color: #f9f9f9;
    border-radius: 10px;
    overflow-x: auto;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border: none;
    background-color: transparent;
    color: #333;
    cursor: pointer;
    transition: color 0.3s ease;
    position: relative;
    white-space: nowrap;
  }

  .filter-btn::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #333;
    transition: width 0.3s ease;
  }

  .filter-btn:hover::after,
  .filter-btn.active::after {
    width: 100%;
  }

  .filter-btn.active {
    font-weight: bold;
  }

  .masonry-grid {
    column-count: 4; 
    column-gap: 1rem; 
  }

  .masonry-item {
    break-inside: avoid; 
    margin-bottom: 1rem; 
    transition: opacity 0.5s ease; 
   overflow:hidden; /* Asegúrate de que las imágenes no se desborden */
   position: relative; /* Añadido para permitir el efecto de hover */
   }

   .masonry-item img {
     width:100%; 
     height:auto; 
     display:block; 
     transition: transform .3s ease; /* Transición suave para el efecto de hover */
   }

   .masonry-item:hover img {
     transform: scale(1.05); /* Efecto de zoom al hacer hover */
   }

 @media (max-width :1024px) {
   .masonry-grid {
     column-count :3; 
   }
 }

 @media (max-width :768px) {
   .masonry-grid {
     column-count :2; 
   }
   
   .filter-btn {
     padding :0.4rem 0.8rem; 
     font-size :0.8rem; 
   }
 }

 @media (max-width :480px) {
   .masonry-grid {
     column-count :1; 
   }
 }
</style>

---
import { Image } from 'astro:assets';

// Importa tus imágenes desde assets/fotos
const images = await Astro.glob('/src/assets/fotos/*.{jpg,jpeg,png,gif}');
---

<div class="masonry-grid">
  {images.map((image, index) => (
    <div class="masonry-item">
      <img
        src={image.default.src}
        alt={`Fotografía ${index + 1}`}
        width={400}
        height={image.default.height * (400 / image.default.width)}
        class="gallery-image"
        data-index={index}
      />
    </div>
  ))}
</div>

<div id="lightbox" class="lightbox">
  <span class="close">&times;</span>
  <img class="lightbox-content" id="lightbox-image" src="" alt="Lightbox image">
</div>

<style>
  /* ... (mantén los estilos anteriores) ... */

  .lightbox {
    display: none;
    position: fixed;
    z-index: 999;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.9);
    justify-content: center;
    align-items: center;
  }

  .lightbox-content {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }

  .close {
    position: absolute;
    top: 15px;
    right: 35px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
  }
</style>

<script>
  function setupLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const images = document.querySelectorAll('.gallery-image');
    const closeButton = document.querySelector('.close');

    if (lightbox && lightboxImage && closeButton) {
      images.forEach(img => {
        img.addEventListener('click', () => {
          lightbox.style.display = 'flex';
          if (img instanceof HTMLImageElement && lightboxImage instanceof HTMLImageElement) {
            lightboxImage.src = img.src;
          }
        });
      });

      closeButton.addEventListener('click', () => {
        if (lightbox instanceof HTMLElement) {
          lightbox.style.display = 'none';
        }
      });

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          lightbox.style.display = 'none';
        }
      });
    }
  }

  // Ejecutar setupLightbox cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', setupLightbox);

  // Para compatibilidad con la navegación de Astro, también ejecutamos en astro:page-load
  document.addEventListener('astro:page-load', setupLightbox);
</script>

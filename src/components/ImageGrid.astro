---
import MyImageComponent from './MyImageComponent.astro';
import { images } from '../data/images.js'; // Asegúrate de que este archivo contenga tus imágenes

const categories = ['Todo', 'Retrato', 'Guangzhou', 'Hong Kong', 'Macao'];
let selectedCategory = 'Todo';
---

<div>
   <h2>Galería de Imágenes</h2>

   <div class="category-buttons">
       {categories.map(category => (
           <button onclick={() => selectedCategory = category}>{category}</button>
       ))}
   </div>

   <MyImageComponent images={images} selectedCategory={selectedCategory} />
</div>

<style>
   /* Agrega tus estilos aquí */
</style>

---
const categories = ["", "HongKong", "Macao", "Guangzhou", "Retrato"];
const images = [
  { src: "/assets/fotos/HongKong/image1.jpg", alt: "Imagen de Hong Kong", category: "HongKong" },
  { src: "/assets/fotos/Macao/image1.jpg", alt: "Imagen de Macao", category: "Macao" },
  { src: "/assets/fotos/Guangzhou/image1.jpg", alt: "Imagen de Guangzhou", category: "Guangzhou" },
  { src: "/assets/fotos/Retrato/image1.jpg", alt: "Imagen de Retrato", category: "Retrato" },
];

function filterImages(category) {
  const gallery = document.getElementById("image-grid");
  const filteredImages = category
    ? images.filter((image) => image.category === category)
    : images;

  gallery.innerHTML = filteredImages
    .map(
      (image) => `
      <div class="image-card">
        <img src="${image.src}" alt="${image.alt}" />
      </div>
    `
    )
    .join("");
}
---

<div>
  <div class="categories">
    {categories.map((category) => (
      <button
        class={`category-button`}
        onclick={`filterImages('${category}')`}
      >
        {category || "Todos"}
      </button>
    ))}
  </div>

  <div id="image-grid" class="image-grid">
    <!-- Se inicializa con todas las imágenes -->
    {images.map((image) => (
      <div class="image-card">
        <img src={image.src} alt={image.alt} />
      </div>
    ))}
  </div>
</div>

<script>
  // Para inicializar las imágenes
  filterImages("");
</script>
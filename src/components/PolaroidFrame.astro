---
interface Props {
  src: string;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<div class="polaroid">
  <img src={src} alt={alt} />
  <div class="caption">{caption}</div>
</div>

<style>
  .polaroid {
    background: #fff;
    padding: 1rem;
    padding-bottom: 3rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    display: inline-block;
    margin: 0 auto;
    max-width: 300px;
    transform: rotate(-2deg);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .caption {
    font-size: 1.1rem;
    text-align: center;
    margin-top: 1rem;
  }
</style>